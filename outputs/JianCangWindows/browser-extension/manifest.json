{
  "manifest_version": 3,
  "name": "见藏 · 浏览器采集",
  "description": "拖动或批量采集网页图片，按规则归档或保存到指定集合。需要运行 Windows 版见藏。",
  "version": "1.4.1",
  "key": "",
  "permissions": ["activeTab", "alarms", "contextMenus", "notifications", "offscreen", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_icon": "icon.png", "default_title": "见藏 · 打开采集面板" },
  "icons": { "128": "icon.png" },
  "options_page": "options.html"
}
